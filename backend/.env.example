# ======================
# Backend
# ======================
PORT=3000
NODE_ENV=development
# DEV ONLY: allow POST /challenges/dev/post-easy-medium-hard (no JWT). Never true in production.
# ENABLE_DEV_CHALLENGE_SEED=true
# Also allows POST /competitions/dev/seed-sample-contests. Or use only competitions seed:
# ENABLE_DEV_COMPETITION_SEED=true
HTTP_BODY_LIMIT=1mb

# ======================
# CORS
# ======================
# Production: exact list of origins (comma-separated). Do not use * with credentials.
# Backend compares the Origin header against this list (see main.ts). Align VITE_API_URL to the same API origin.
# Include http://localhost:5174 for the MUI admin dashboard (react-mui-ts-template)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ======================
# Challenges list
# =====================
# List sorted by createdAt desc. "New" badge on API when created less than N days ago.
# CHALLENGE_NEW_DAYS=14

# ======================
# Rate Limiting
# ======================
RATE_LIMIT_POINTS_PER_MINUTE=120
# Per user / minute (submissions & code execution - see ActionRateLimitGuard)
# RATE_LIMIT_CHALLENGE_RUN_PER_MINUTE=45
# RATE_LIMIT_CHALLENGE_SUBMIT_PER_MINUTE=25
# RATE_LIMIT_CODE_EXEC_PER_MINUTE=45
# RATE_LIMIT_COMPETITION_SUBMIT_PER_MINUTE=30
# RATE_LIMIT_RECLAMATION_SUBMIT_PER_MINUTE=10
# RATE_LIMIT_SITE_RATING_SUBMIT_PER_MINUTE=30
# Chat Socket.IO (gateway)
# CHAT_MESSAGE_MAX_CHARS=2000
# CHAT_RATE_WINDOW_MS=10000
# CHAT_RATE_MAX_PER_WINDOW=25

# ======================
# 1v1 Battles (WebSocket + MongoDB)
# ======================
# Countdown length in seconds once both players are ready (30–7200).
# BATTLE_DURATION_SECONDS=600
# Max submit_code attempts per player (single graded submit remains locked once accepted).
# BATTLE_MAX_SUBMITS_PER_PLAYER=3

# ======================
# JWT Configuration
# ======================
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ======================
# Admin seeding (npm run seed:admin)
# ======================
# SEED_ADMIN_EMAIL=admin@bytebattle.com
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=password123
# Promote an existing user: npm run make-admin -- you@email.com

# ======================
# Database
# ======================
MONGODB_URI=mongodb://localhost:27017/bytebattle
# PostgreSQL alternative (optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/bytebattle

# ======================
# Google OAuth
# ======================
# Google OAuth
GOOGLE_CLIENT_ID=571242187901-qu1f0gvelet0iqbg5uga0c563sgegg4k.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Frontend (for redirect after login)
FRONTEND_URL=http://localhost:5173

# ======================
# GitHub OAuth (Optional)
# ======================
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# ======================
# Code execution (Piston)
# ======================
# Backend default (without variable): http://127.0.0.1:2000/api/v2/execute - start Docker with .\scripts\start-piston.ps1 then ppman install (see backend/src/code-execution/README.md).
# emkc.org is allowlisted since 02/2026; to use it you need a key/approval (PISTON_API_KEY if required).
# PISTON_ENDPOINT=http://127.0.0.1:2000/api/v2/execute
# Force local execution (Node / Python / ... on server) when tools are installed:
# CODE_EXECUTION_PREFER_LOCAL=true
# Legacy: force Piston only
# CODE_EXECUTION_PREFER_PISTON=true
# Optional: required if the public API demands it; not needed for self-hosted Piston
# PISTON_API_KEY=
# Timeout per execution (ms). Piston run_timeout is capped at 15000.
# CODE_EXECUTION_TIMEOUT_MS=15000
# Max code length (bytes/chars) — used by execution + SubmitChallengeDto validation
# CODE_EXECUTION_MAX_CODE_CHARS=20000
# Challenge anti-cheat: testCases with isHidden=true (Mongo default) do not expose input/expected/actual on submit API.

# ======================
# Email (verification / password reset)
# Use either MAIL_* or SMTP_* (both supported)
# Leave host unset to disable SMTP in dev (links logged in console)
# ======================
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
