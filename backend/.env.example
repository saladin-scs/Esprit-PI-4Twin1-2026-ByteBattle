# ======================
# Backend
# ======================
PORT=3000
NODE_ENV=development
HTTP_BODY_LIMIT=1mb

# ======================
# CORS
# ======================
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ======================
# Rate Limiting
# ======================
RATE_LIMIT_POINTS_PER_MINUTE=120

# ======================
# JWT Configuration
# ======================
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ======================
# Database
# ======================
MONGODB_URI=mongodb://localhost:27017/bytebattle
# PostgreSQL alternative (optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/bytebattle

# ======================
# Google OAuth
# ======================
# Google OAuth
GOOGLE_CLIENT_ID=571242187901-qu1f0gvelet0iqbg5uga0c563sgegg4k.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Frontend (for redirect after login)
FRONTEND_URL=http://localhost:5173

# ======================
# GitHub OAuth (Optional)
# ======================
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# ======================
# Code execution (Piston – remote)
# ======================
# URL of the Piston API (default: public mirror). For self-hosted: http://localhost:2000/api/v2/execute
PISTON_ENDPOINT=https://emkc.org/api/v2/piston/execute
# Optional: required if the public API demands it; not needed for self-hosted Piston
# PISTON_API_KEY=
# Timeout per execution (ms). Piston run_timeout is capped at 15000.
# CODE_EXECUTION_TIMEOUT_MS=15000

# ======================
# Email (for verification / password reset)
# ======================
 SMTP_HOST=smtp.gmail.com
 SMTP_PORT=587
 SMTP_USER=chebbimed514@gmail.com
 SMTP_PASS=uqkgxpunsiblykps
