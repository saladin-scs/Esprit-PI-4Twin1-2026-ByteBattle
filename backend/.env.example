# ======================
# Backend
# ======================
PORT=3000
NODE_ENV=development
HTTP_BODY_LIMIT=1mb

# ======================
# CORS
# ======================
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ======================
# JWT
# ======================
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ======================
# Database
# ======================
MONGODB_URI=mongodb://localhost:27017/bytebattle

# ======================
# FRONTEND REDIRECT (IMPORTANT)
# ======================
FRONTEND_URL=http://localhost:5173

# ======================
# GOOGLE OAUTH (FIXED)
# ======================
GOOGLE_CLIENT_ID=350957869028-5fs178rvmi5csgg8fi6tftdiv9iqcq5j.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_NEW_GOOGLE_SECRET
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ======================
# GITHUB OAUTH (FIXED - MUST BE FILLED)
# ======================
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# ======================
# OPTIONAL DEV SETTINGS
# ======================
# ENABLE_DEV_CHALLENGE_SEED=true
# ENABLE_DEV_COMPETITION_SEED=true