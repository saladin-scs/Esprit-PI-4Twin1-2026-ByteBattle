{
  "name": "bytebattle-backend",
  "version": "1.0.0",
  "description": "ByteBattle Backend - Real-Time Collaborative Coding Challenge Platform",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:ci": "eslint -c .eslintrc.ci.js \"src/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed:challenges": "ts-node scripts/seed-challenges.run.ts",
    "seed:users": "ts-node -r tsconfig-paths/register scripts/seed-users.run.ts",
    "normalize:starter-codes": "ts-node scripts/normalize-starter-accepted.run.ts",
    "normalize:starter-codes:template": "ts-node scripts/normalize-starter-template.run.ts",
    "seed:competitions": "ts-node -r tsconfig-paths/register scripts/seed-competitions.run.ts",
    "extend:competitions": "ts-node -r tsconfig-paths/register scripts/extend-competitions.run.ts",
    "seed:admin": "ts-node -r tsconfig-paths/register scripts/seed-admin.ts",
    "seed:platform-demo": "ts-node -r tsconfig-paths/register scripts/seed-platform-demo.run.ts",
    "seed:notifications": "ts-node -r tsconfig-paths/register scripts/seed-notifications.run.ts",
    "seed:extra-data": "ts-node scripts/seed-extra-data.run.ts",
    "seed:bulk": "ts-node -r tsconfig-paths/register scripts/seed-bulk-data.run.ts",
    "seed:all": "ts-node -r tsconfig-paths/register scripts/seed-all-data.run.ts",
    "migrate:test-to-bytebattle": "ts-node -r tsconfig-paths/register scripts/migrate-test-to-bytebattle.run.ts",
    "make-admin": "ts-node -r tsconfig-paths/register scripts/make-admin.run.ts",
    "test:ci": "jest --ci --coverage --passWithNoTests --reporters=default --reporters=jest-junit",
    "audit:ci": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/websockets": "^10.4.22",
    "@types/cookie-parser": "^1.4.10",
    "axios": "^1.13.5",
    "bcrypt": "^5.1.1",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "dockerode": "^4.0.9",
    "dotenv": "^17.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.21.1",
    "multer": "^2.1.1",
    "nest-winston": "^1.10.2",
    "nodemailer": "^8.0.3",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^9.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.1",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.4.22",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.11",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.19.30",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-github2": "^1.0.9",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/qrcode": "^1.5.5",
    "@types/serve-static": "^2.2.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.1.1",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        { "tsconfig": "<rootDir>/../tsconfig.spec.json" }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "jest-junit": {
    "outputDirectory": "coverage",
    "outputName": "junit.xml"
  },
  "main": ".eslintrc.js",
  "keywords": [],
  "type": "commonjs"
}
