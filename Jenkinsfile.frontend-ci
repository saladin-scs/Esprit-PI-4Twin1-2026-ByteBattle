pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    triggers {
        githubPush()
    }

    tools {
        nodejs 'NodeJS-20'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install') {
            steps {
                dir('frontend') {
                    sh 'npm ci'
                }
            }
        }

        stage('Lint') {
            steps {
                dir('frontend') {
                    sh 'npm run lint:ci'
                }
            }
        }

        stage('Test') {
            steps {
                dir('frontend') {
                    sh 'npm run test:ci'
                }
            }
            post {
                always {
                    junit testResults: 'frontend/coverage/junit.xml', allowEmptyResults: true
                }
            }
        }

        stage('Build') {
            steps {
                dir('frontend') {
                    sh 'npm run build'
                }
            }
        }

        stage('SonarQube') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                        dir('frontend') {
                            sh 'npx sonar-scanner -Dproject.settings=sonar-project.properties -Dsonar.host.url=$SONAR_HOST_URL -Dsonar.token=$SONAR_TOKEN'
                        }
                    }
                }
            }
        }

        stage('Trigger Frontend CD') {
            steps {
                build job: 'frontend-cd', wait: false, parameters: [
                    string(name: 'IMAGE_TAG', value: sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim())
                ]
            }
        }
    }
}
