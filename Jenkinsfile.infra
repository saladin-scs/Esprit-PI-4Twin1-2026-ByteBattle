pipeline {
    agent any

    stages {
        stage('Deploy MongoDB') {
            steps {
                echo '🍃 Deploying MongoDB to Kubernetes...'
                sh 'kubectl apply -f mongodb-deployment.yaml'
            }
        }

        stage('Status Check') {
            steps {
                sh 'kubectl get pods'
                sh 'kubectl get services'
            }
        }
    }
}
