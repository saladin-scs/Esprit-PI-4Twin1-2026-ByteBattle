# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|

  # ─── VM Jenkins ────────────────────────────────────────────────
  config.vm.define "jenkins" do |jenkins|
    jenkins.vm.box = "ubuntu/jammy64"
    jenkins.vm.hostname = "jenkins"
    jenkins.vm.network "private_network", ip: "192.168.56.10"
    jenkins.vm.network "forwarded_port", guest: 8080, host: 8080   # Jenkins
    jenkins.vm.network "forwarded_port", guest: 50000, host: 50000 # Jenkins agents

    jenkins.vm.provider "virtualbox" do |vb|
      vb.name   = "ByteBattle-Jenkins"
      vb.memory = "3048"
      vb.cpus   = 2
    end

    jenkins.vm.provision "shell", path: "scripts/install_jenkins.sh"
  end

  # ─── VM SonarQube ──────────────────────────────────────────────
  config.vm.define "sonarqube" do |sonar|
    sonar.vm.box = "ubuntu/jammy64"
    sonar.vm.hostname = "sonarqube"
    sonar.vm.network "private_network", ip: "192.168.56.20"
    sonar.vm.network "forwarded_port", guest: 9000, host: 9000

    sonar.vm.provider "virtualbox" do |vb|
      vb.name   = "ByteBattle-SonarQube"
      vb.memory = "3072"
      vb.cpus   = 2
    end

    sonar.vm.provision "shell", path: "scripts/install_sonarqube.sh"
  end

end