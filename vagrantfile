# -*- mode: ruby -*-
# vi: set ft=ruby :

VAGRANTFILE_API_VERSION = "2"

CLUSTER_PREFIX = "bytebattle"
BASE_BOX = "ubuntu/jammy64"

# ============================================
# CONFIGURATION RÉSEAU – UNIVERSITÉ (BRIDGED)
# ============================================
# Tous les membres doivent partager le même sous‑réseau (SUBNET) et des IP uniques.
# Adaptez‑les à votre réseau local.
SUBNET = "172.16.9"                    # ← changer selon votre réseau
BRIDGE_INTERFACE = "Realtek PCIe GbE"   # ← nom exact de l'interface sous Windows

# ============================================
# RÔLES DU CLUSTER (IPs bridgées)
# ============================================
ROLES = {
  "saladin" => {
    hostname: "bytebattle-master",
    ip: "#{SUBNET}.11",
    role: "worker",          # ← devient worker
    cpu: 2,
    memory: 4096,
    ports: {
      6443 => 6443,          # (optionnel) si vous avez besoin d'accéder à l'API depuis l'hôte
      8080 => 8080,
      9000 => 9000,
      9090 => 9090,
      9093 => 9093
    }
  },

  "mayss" => {
    hostname: "bytebattle-cp2",
    ip: "#{SUBNET}.12",
    role: "master",          # ← leader du cluster
    cpu: 2,
    memory: 4096,
    ports: {}
  },

  "member3" => {
    hostname: "bytebattle-cp3",
    ip: "#{SUBNET}.13",
    role: "master",
    cpu: 2,
    memory: 4096,
    ports: {}
  },

  "member4" => {
    hostname: "bytebattle-worker1",
    ip: "#{SUBNET}.21",
    role: "worker",
    cpu: 1,
    memory: 2048,
    ports: {}
  },

  "member5" => {
    hostname: "bytebattle-worker2",
    ip: "#{SUBNET}.22",
    role: "worker",
    cpu: 1,
    memory: 2048,
    ports: {}
  },

  "lb" => {
    hostname: "bytebattle-lb",
    ip: "#{SUBNET}.10",
    role: "lb",
    cpu: 1,
    memory: 512,
    ports: {}
  }
}.freeze

# ============================================
# 🔧 PROFIL ACTIF – LEADER du cluster
# ============================================
# Le nœud « mayss » exécutera `kubeadm init`.
# Le nœud « saladin » rejoindra le cluster comme worker.
MY_ROLE   = "mayss"
MY_CONFIG = ROLES[MY_ROLE]

# Variable booléenne permettant de différencier le leader du worker
IS_LEADER = true

# ============================================
# VAGRANT CONFIG
# ============================================
Vagrant.configure(VAGRANTFILE_API_VERSION) do |config|
  config.vm.box = BASE_BOX
  config.vm.boot_timeout = 600
  config.vm.box_check_update = false
  config.vm.synced_folder ".", "/vagrant", type: "virtualbox"

  config.vm.provider "virtualbox" do |vb|
    vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
    vb.customize ["modifyvm", :id, "--natdnsproxy1", "on"]
    vb.customize ["modifyvm", :id, "--audio", "none"]
    vb.customize ["modifyvm", :id, "--usb", "off"]
  end

  # -----------------------------------------------------------------
  # VM LEADER – mayss
  # -----------------------------------------------------------------
  config.vm.define MY_ROLE, primary: true do |node|
    node.vm.hostname = MY_CONFIG[:hostname]

    # ----- RÉSEAU BRIDGÉ (public) -----
    node.vm.network "public_network",
                    ip: MY_CONFIG[:ip],
                    bridge: "Default"

    node.vm.provider "virtualbox" do |vb|
      vb.name   = "#{CLUSTER_PREFIX}-#{MY_ROLE}"
      vb.cpus   = MY_CONFIG[:cpu]
      vb.memory = MY_CONFIG[:memory]
    end

    # ==============================
    # PROVISIONING du LEADER
    # ==============================
    node.vm.provision "shell", inline: <<-SHELL
      set -e
      echo "===================================="
      echo "🚀 Setup LEADER (#{MY_CONFIG[:hostname]})"
      echo "===================================="

      # ----- Désactiver swap -----
      sudo swapoff -a
      sudo sed -i '/ swap / s/^/#/' /etc/fstab

      # ----- Modules kernel -----
      cat <<EOF | sudo tee /etc/modules-load.d/k8s.conf
      overlay
      br_netfilter
      EOF
      sudo modprobe overlay
      sudo modprobe br_netfilter

      # ----- Sysctl -----
      cat <<EOF | sudo tee /etc/sysctl.d/k8s.conf
      net.bridge.bridge-nf-call-iptables=1
      net.bridge.bridge-nf-call-ip6tables=1
      net.ipv4.ip_forward=1
      EOF
      sudo sysctl --system

      # ----- /etc/hosts (entries pour tout le cluster) -----
      cat <<EOF | sudo tee -a /etc/hosts
      #{SUBNET}.10 bytebattle-lb
      #{SUBNET}.11 bytebattle-master
      #{SUBNET}.12 bytebattle-cp2
      #{SUBNET}.13 bytebattle-cp3
      #{SUBNET}.21 bytebattle-worker1
      #{SUBNET}.22 bytebattle-worker2
      EOF

      # ----- Containerd -----
      sudo apt-get update
      sudo apt-get install -y containerd
      sudo mkdir -p /etc/containerd
      containerd config default | sudo tee /etc/containerd/config.toml > /dev/null
      sudo systemctl restart containerd

      # ----- Kubernetes (kubeadm, kubelet, kubectl) -----
      sudo apt-get install -y curl gnupg apt-transport-https ca-certificates
      sudo mkdir -p /etc/apt/keyrings
      curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.29/deb/Release.key | sudo gpg --dearmor -o /etc/apt/keyrings/kubernetes.gpg
      echo "deb [signed-by=/etc/apt/keyrings/kubernetes.gpg] https://pkgs.k8s.io/core:/stable:/v1.29/deb/ /" | sudo tee /etc/apt/sources.list.d/kubernetes.list
      sudo apt-get update
      sudo apt-get install -y kubelet kubeadm kubectl
      sudo apt-mark hold kubelet kubeadm kubectl

      # ----- Force kubelet à utiliser l'IP bridgée -----
      echo "KUBELET_EXTRA_ARGS=--node-ip=#{MY_CONFIG[:ip]}" | sudo tee /etc/default/kubelet
      sudo systemctl restart kubelet

      # ----- Docker (optionnel) -----
      curl -fsSL https://get.docker.com | sh
      sudo usermod -aG docker vagrant

      # ----- Helm (optionnel) -----
      curl -fsSL -o get_helm.sh https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3
      chmod 700 get_helm.sh
      ./get_helm.sh
      rm get_helm.sh

      # --------------------------------------------------------------
      # Initialisation du cluster (seulement si LEADER)
      # --------------------------------------------------------------
      if [ "#{IS_LEADER}" = "true" ]; then
        echo "🧭  LEADER (#{MY_CONFIG[:hostname]}) → Initialisation du cluster"
        sudo kubeadm init --pod-network-cidr=10.244.0.0/16 --apiserver-advertise-address=#{MY_CONFIG[:ip]}

        # Crée le répertoire partagé et le script de join
        sudo mkdir -p /vagrant/join-scripts
        sudo kubeadm token create --print-join-command > /vagrant/join-scripts/master-join.sh
        sudo chmod +x /vagrant/join-scripts/master-join.sh

        # Configure kubeconfig pour l'utilisateur vagrant
        mkdir -p $HOME/.kube
        sudo cp -i /etc/kubernetes/admin.conf $HOME/.kube/config
        sudo chown $(id -u):$(id -g) $HOME/.kube/config

        # Installe Flannel (CNI) – uniquement sur le leader
        kubectl apply -f https://raw.githubusercontent.com/flannel-io/flannel/master/Documentation/kube-flannel.yml

        echo "✅ Leader initialisé – les workers peuvent rejoindre avec :"
        echo "   sudo /vagrant/join-scripts/master-join.sh"
      fi
    SHELL
  end

  # -----------------------------------------------------------------
  # VM WORKER – saladin
  # -----------------------------------------------------------------
  config.vm.define "saladin", primary: false do |node|
    node.vm.hostname = ROLES["saladin"][:hostname]

    # ----- RÉSEAU BRIDGÉ (public) -----
    node.vm.network "public_network",
                    ip: ROLES["saladin"][:ip],
                    bridge: "Default"

    node.vm.provider "virtualbox" do |vb|
      vb.name   = "#{CLUSTER_PREFIX}-saladin"
      vb.cpus   = ROLES["saladin"][:cpu]
      vb.memory = ROLES["saladin"][:memory]
    end

    # ==============================
    # PROVISIONING du WORKER
    # ==============================
    node.vm.provision "shell", inline: <<-SHELL
      set -e
      echo "===================================="
      echo "🚀 Setup WORKER (#{ROLES["saladin"][:hostname]})"
      echo "===================================="

      # ----- Désactiver swap -----
      sudo swapoff -a
      sudo sed -i '/ swap / s/^/#/' /etc/fstab

      # ----- Modules kernel -----
      cat <<EOF | sudo tee /etc/modules-load.d/k8s.conf
      overlay
      br_netfilter
      EOF
      sudo modprobe overlay
      sudo modprobe br_netfilter

      # ----- Sysctl -----
      cat <<EOF | sudo tee /etc/sysctl.d/k8s.conf
      net.bridge.bridge-nf-call-iptables=1
      net.bridge.bridge-nf-call-ip6tables=1
      net.ipv4.ip_forward=1
      EOF
      sudo sysctl --system

      # ----- /etc/hosts (ajoute les entrées du cluster) -----
      cat <<EOF | sudo tee -a /etc/hosts
      #{SUBNET}.10 bytebattle-lb
      #{SUBNET}.11 bytebattle-master
      #{SUBNET}.12 bytebattle-cp2
      #{SUBNET}.13 bytebattle-cp3
      #{SUBNET}.21 bytebattle-worker1
      #{SUBNET}.22 bytebattle-worker2
      EOF

      # ----- Containerd -----
      sudo apt-get update
      sudo apt-get install -y containerd
      sudo mkdir -p /etc/containerd
      containerd config default | sudo tee /etc/containerd/config.toml > /dev/null
      sudo systemctl restart containerd

      # ----- Kubernetes (kubeadm, kubelet, kubectl) -----
      sudo apt-get install -y curl gnupg apt-transport-https ca-certificates
      sudo mkdir -p /etc/apt/keyrings
      curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.29/deb/Release.key | sudo gpg --dearmor -o /etc/apt/keyrings/kubernetes.gpg
      echo "deb [signed-by=/etc/apt/keyrings/kubernetes.gpg] https://pkgs.k8s.io/core:/stable:/v1.29/deb/ /" | sudo tee /etc/apt/sources.list.d/kubernetes.list
      sudo apt-get update
      sudo apt-get install -y kubelet kubeadm kubectl
      sudo apt-mark hold kubelet kubeadm kubectl

      # ----- Force kubelet à utiliser l'IP bridgée -----
      echo "KUBELET_EXTRA_ARGS=--node-ip=#{ROLES["saladin"][:ip]}" | sudo tee /etc/default/kubelet
      sudo systemctl restart kubelet

      # ----- Docker (optionnel) -----
      curl -fsSL https://get.docker.com | sh
      sudo usermod -aG docker vagrant

      # ----- Helm (optionnel) -----
      curl -fsSL -o get_helm.sh https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3
      chmod 700 get_helm.sh
      ./get_helm.sh
      rm get_helm.sh

      # --------------------------------------------------------------
      # Worker – attend le script de join généré par le leader
      # --------------------------------------------------------------
      if [ "#{IS_LEADER}" = "false" ]; then
        echo "🔧  WORKER (#{ROLES["saladin"][:hostname]}) – en attente du script de join"
        while [ ! -f /vagrant/join-scripts/master-join.sh ]; do
          echo "⏳  En attente du script master‑join.sh …"
          sleep 5
        done
        echo "🚀  WORKER détecte le script – rejoint le cluster"
        sudo bash /vagrant/join-scripts/master-join.sh
      fi
    SHELL
  end
end

# ============================================
# MESSAGE DE FIN (affiché lors du `vagrant up`)
# ============================================
puts <<~INFO

╔══════════════════════════════════════════════════════════════╗
║   BYTEBATTLE – CLUSTER CONFIGURATION                       ║
╚══════════════════════════════════════════════════════════════╝

✅  Leader : #{MY_CONFIG[:hostname]}  (IP #{MY_CONFIG[:ip]})
✅  Worker : #{ROLES["saladin"][:hostname]}  (IP #{ROLES["saladin"][:ip]})

🚀  Procédez ainsi :
   1️⃣ vagrant up                # démarre leader + worker
   2️⃣ vagrant ssh mayss         # le leader initialise le cluster (kubeadm init)
   3️⃣ Les workers rejoindront automatiquement dès que le script
      /vagrant/join-scripts/master‑join.sh sera créé.

🌐  Accès aux services :
   - Jenkins  : http://localhost:8081   (forwarded depuis le worker)
   - SonarQube: http://localhost:9000
   - Prometheus: http://localhost:9090
   - Alertmanager: http://localhost:9093

⚠️  CONSEIL :
   - Adaptez `SUBNET` et `BRIDGE_INTERFACE` à votre réseau local.
   - Si vous modifiez l’IP d’un nœud, recréez les VMs (`vagrant destroy -f && vagrant up`).

INFO
