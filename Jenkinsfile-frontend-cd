pipeline {
    agent any

    environment {
        IMAGE = "bytebattle-frontend"
        REGISTRY = "YOUR_DOCKERHUB_USERNAME"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t bytebattle-frontend:latest ./frontend'
            }
        }

        stage('Docker Login') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                    sh '''
                        echo $PASS | docker login -u $USER --password-stdin
                    '''
                }
            }
        }

        stage('Push Image') {
            steps {
                sh '''
                    docker tag bytebattle-frontend:latest $REGISTRY/bytebattle-frontend:latest
                    docker push $REGISTRY/bytebattle-frontend:latest
                '''
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh 'kubectl apply -f k8s/frontend.yaml'
            }
        }
    }
}
