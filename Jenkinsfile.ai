pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo '📥 Cloning repository...'
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('bytebattle-ai-service') {
                    echo '🔨 Building AI Service Docker image...'
                    sh 'docker build -t bytebattle-ai-service:latest .'
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                echo '🚀 Deploying AI Service to Kubernetes...'
                // On pourrait ajouter un fichier ai-deployment.yaml ici, mais on va simuler ou utiliser kubectl run
                sh 'kubectl apply -f ai-deployment.yaml' || echo '⚠️ ai-deployment.yaml not found, skipped.'
            }
        }
    }
}
