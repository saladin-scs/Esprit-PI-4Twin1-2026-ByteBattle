# Copier vers .env — URL du backend (sans slash final). En prod : HTTPS + domaine exact ;
# le backend doit lister l’origine du front dans CORS_ORIGIN (pas de * avec cookies / credentials).
VITE_API_URL=http://localhost:3000
# Temporary test mode: prefill editor code with ready snippets (set false to disable later)
VITE_PREFILL_TEST_SOLUTIONS=true
