# Docker Compose variables (copy to .env for local dev)

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=bytebattle

# Backend
NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# Mêmes origines que backend/.env.example (front Vite 5173 + admin 5174 si besoin)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
AI_SERVICE_URL=http://ai-service:8000
OPENROUTER_API_KEY=

# Frontend (Vite) — copier aussi dans frontend/.env ; doit viser le même hôte:port que PORT ci-dessus
VITE_API_URL=http://localhost:3000
