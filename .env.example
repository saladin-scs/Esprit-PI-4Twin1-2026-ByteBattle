# Docker Compose variables (copy to .env for local dev)

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=bytebattle

# Backend
NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# Same origins as backend/.env.example (Vite frontend 5173 + admin 5174 if needed)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Frontend (Vite) - also copy to frontend/.env; must target the same host:port as PORT above
VITE_API_URL=http://localhost:3000
