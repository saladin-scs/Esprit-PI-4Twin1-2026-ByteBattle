pipeline {
    agent any

    environment {
        NODE_VERSION = '20'
        SONAR_PROJECT_KEY = 'bytebattle-frontend'
        SONAR_PROJECT_NAME = 'ByteBattle Frontend'
    }

    tools {
        nodejs 'NodeJS-20'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '📥 Cloning repository...'
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('frontend') {
                    echo '📦 Installing dependencies...'
                    sh 'npm ci'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('frontend') {
                    echo '🧪 Running unit tests...'
                    sh 'npm run test -- --coverage --watchAll=false --reporter=verbose'
                }
            }
            post {
                always {
                    dir('frontend') {
                        junit testResults: 'coverage/junit.xml', allowEmptyResults: true
                        publishHTML(target: [
                            allowMissing: true,
                            alwaysLinkToLastBuild: true,
                            keepAll: true,
                            reportDir: 'coverage/lcov-report',
                            reportFiles: 'index.html',
                            reportName: 'Frontend Coverage Report'
                        ])
                    }
                }
                failure {
                    echo '❌ Unit tests failed!'
                }
                success {
                    echo '✅ Unit tests passed!'
                }
            }
        }

        stage('Build') {
            steps {
                dir('frontend') {
                    echo '🔨 Building frontend...'
                    sh 'npm run build'
                }
            }
            post {
                success {
                    echo '✅ Build successful!'
                }
                failure {
                    echo '❌ Build failed!'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('frontend') {
                    echo '🔍 Running SonarQube analysis...'
                    withSonarQubeEnv('SonarQube') {
                        withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                            writeFile file: 'sonar-project.properties', text: '''
sonar.projectKey=bytebattle-frontend
sonar.projectName=ByteBattle Frontend
sonar.sources=src
sonar.exclusions=**/node_modules/**,**/dist/**,**/*.test.tsx,**/*.test.ts,**/coverage/**
sonar.tests=src
sonar.test.inclusions=**/*.test.tsx,**/*.test.ts,**/*.spec.tsx,**/*.spec.ts
sonar.javascript.lcov.reportPaths=coverage/lcov.info
sonar.typescript.tsconfigPath=tsconfig.json
sonar.sourceEncoding=UTF-8
'''
                            sh '''
                                npx sonar-scanner \
                                    -Dproject.settings=sonar-project.properties \
                                    -Dsonar.host.url="$SONAR_HOST_URL" \
                                    -Dsonar.login="$SONAR_TOKEN"
                            '''
                        }
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                echo '🚦 Checking SonarQube Quality Gate...'
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
            post {
                success {
                    echo '✅ Quality Gate passed!'
                }
                failure {
                    echo '❌ Quality Gate failed!'
                }
            }
        }

    }

    post {
        always {
            echo '🧹 Cleaning workspace...'
            cleanWs()
        }
        success {
            echo '🎉 Frontend pipeline completed successfully!'
        }
        failure {
            echo '💥 Frontend pipeline failed!'
        }
    }
}