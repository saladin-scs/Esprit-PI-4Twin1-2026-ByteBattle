pipeline {
    agent any
    
    tools {
        nodejs 'nodejs-18'
    }
    
    parameters {
        choice(
            name: 'DEPLOY_ENV',
            choices: ['dev', 'staging', 'production'],
            description: '🌍 Deployment environment'
        )
        string(
            name: 'BUILD_NUMBER',
            defaultValue: 'latest',
            description: '🏷️ Build number to deploy (e.g. 12, latest)'
        )
    }
    
    environment {
        // Docker
        BACKEND_IMAGE = "khalfaouisaladin/bytebattle-backend:${params.BUILD_NUMBER}"
        FRONTEND_IMAGE = "khalfaouisaladin/bytebattle-frontend:${params.BUILD_NUMBER}"
        
        // Kubernetes
        KUBECONFIG_CREDENTIAL = 'kubeconfig-credential'
    }
    
    stages {
        stage('Check Images on Docker Hub') {
            steps {
                script {
                    sh '''
                        echo "🔍 Checking images on Docker Hub..."
                        
                        docker pull ${BACKEND_IMAGE} || {
                            echo "❌ Backend image ${BACKEND_IMAGE} not found"
                            exit 1
                        }
                        
                        docker pull ${FRONTEND_IMAGE} || {
                            echo "❌ Frontend image ${FRONTEND_IMAGE} not found"
                            exit 1
                        }
                        
                        echo "✅ Images found"
                        docker images | grep khalfaouisaladin
                    '''
                }
            }
        }
        
        stage('Deploy to Kubernetes') {
            steps {
                script {
                    withKubeConfig([credentialsId: KUBECONFIG_CREDENTIAL]) {
                        sh """
                            echo "🔍 Checking kubectl..."
                            command -v kubectl || echo "⚠️ kubectl not found in PATH"
                            
                            cd ${WORKSPACE}
                            
                            echo "☸️ Deploying to Kubernetes (${params.DEPLOY_ENV})..."
                            
                            # Apply configuration files
                            kubectl apply -f mongodb-deployment.yaml
                            kubectl apply -f backend-deployment.yaml
                            kubectl apply -f frontend-deployment.yaml
                            
                            # Update deployment images
                            kubectl set image deployment/backend backend=${BACKEND_IMAGE}
                            kubectl set image deployment/frontend frontend=${FRONTEND_IMAGE}
                            
                            # Check deployment rollout
                            echo "⏳ Checking deployment rollout..."
                            kubectl rollout status deployment/backend --timeout=120s
                            kubectl rollout status deployment/frontend --timeout=120s
                            
                            # Show current state
                            kubectl get pods
                            kubectl get svc
                            
                            echo "✅ Deployment completed on ${params.DEPLOY_ENV}"
                        """
                    }
                }
            }
        }
        
stage('Smoke Tests') {
    steps {
        script {
            withKubeConfig([credentialsId: KUBECONFIG_CREDENTIAL]) {
                sh '''
                    echo "🔥 Smoke tests..."
                    
                    echo "⏳ Setting up port-forwarding..."
                    
                    # Port-forward backend API (port 3000)
                    kubectl port-forward svc/backend-service 3000:3000 &
                    BACKEND_PF_PID=$!
                    
                    # Port-forward frontend (port 80 -> local 3001)
                    kubectl port-forward svc/frontend-service 3001:80 &
                    FRONTEND_PF_PID=$!
                    
                    # Wait until port-forwards are established
                    sleep 5
                    
                    # Test backend API
                    echo "📡 Testing backend at http://localhost:3000..."
                    BACKEND_RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:3000/health || echo "000")
                    
                    if [ "$BACKEND_RESPONSE" -eq 200 ] || [ "$BACKEND_RESPONSE" -eq 404 ] || [ "$BACKEND_RESPONSE" -eq 401 ]; then
                        echo "✅ Backend responds (HTTP $BACKEND_RESPONSE)"
                        BACKEND_TEST="PASS"
                    else
                        echo "❌ Backend is not responding (HTTP $BACKEND_RESPONSE)"
                        BACKEND_TEST="FAIL"
                        
                        # Debug: show additional details
                        echo "🔍 Verbose debug test:"
                        curl -v http://localhost:3000/health || true
                    fi
                    
                    # Test frontend
                    echo "📡 Testing frontend at http://localhost:3001..."
                    FRONTEND_RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:3001 || echo "000")
                    
                    if [ "$FRONTEND_RESPONSE" -eq 200 ]; then
                        echo "✅ Frontend responds (HTTP $FRONTEND_RESPONSE)"
                        FRONTEND_TEST="PASS"
                    else
                        echo "❌ Frontend is not responding (HTTP $FRONTEND_RESPONSE)"
                        FRONTEND_TEST="FAIL"
                    fi
                    
                    # Clean up port-forwards
                    echo "🧹 Cleaning up port-forwards..."
                    kill $BACKEND_PF_PID 2>/dev/null || true
                    kill $FRONTEND_PF_PID 2>/dev/null || true
                    
                    # Check results
                    if [ "$BACKEND_TEST" = "FAIL" ] || [ "$FRONTEND_TEST" = "FAIL" ]; then
                        echo "❌ Tests failed"
                        exit 1
                    fi
                    
                    echo "✅ All tests passed"
                '''
            }
        }
    }
}
}
    
    post {
        success {
            echo "✅ Deployment succeeded!"
        }
        failure {
            echo "❌ Deployment failed!"
        }
    }
}
